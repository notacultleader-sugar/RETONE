{
  "expo": {
    "name": "Saytwice",
    "slug": "saytwice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12151f",
    "ios": {
      "bundleIdentifier": "ca.notacult.apps.saytwice",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.ca.notacult.apps.saytwice"
        ]
      }
    },
    "android": {
      "package": "ca.notacult.apps.saytwice",
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070c"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-splash-screen",
      "expo-font",
      "./plugins/withReleaseSigning",
      "@bacons/apple-targets",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Saytwice uses this to show ads that are more relevant to you. Saying no still shows ads, just less relevant ones."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "Saytwice uses this to show ads that are more relevant to you. Saying no still shows ads, just less relevant ones.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ]
    ]
  }
}
